# Copy this file to `keystore.properties` (same dir) and fill in the values
# after you've generated your keystore with `keytool` (see README_ANDROID.md).
# DO NOT COMMIT the real `keystore.properties` — it's already in .gitignore.

storeFile=citizen-pathway.keystore
storePassword=CHANGE_ME
keyAlias=citizen-pathway
keyPassword=CHANGE_ME
